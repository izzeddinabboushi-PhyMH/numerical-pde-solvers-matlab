    given-names: Izzeddin
    orcid: "https://orcid.org/0009-0008-7841-7566"
    affiliation: "An-Najah National University"
repository-code: "https://github.com/izzeddinabboushi-PhyMH/numerical-pde-solvers-matlab"
license: MIT
version: 1.0.0
date-released: 2026-10-20
doi: 10.5281/zenodo.23506069
keywords:
  - numerical PDEs
  - finite differences
  - Laplace equation
  - Poisson equation
  - heat equation
  - wave equation
  - Jacobi iteration
  - Gauss-Seidel
  - successive over-relaxation
  - Crank-Nicolson
  - Lax-Wendroff
  - MATLAB
